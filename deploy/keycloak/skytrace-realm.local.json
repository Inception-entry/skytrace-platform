{
  "realm": "skytrace",
  "displayName": "SkyTrace 天巡智控",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "系统管理员"
      },
      {
        "name": "OPERATOR",
        "description": "巡检任务操作员"
      },
      {
        "name": "VIEWER",
        "description": "只读用户"
      }
    ]
  },
  "clients": [
    {
      "clientId": "skytrace-web",
      "name": "SkyTrace Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8888/*",
        "http://127.0.0.1:8888/*"
      ],
      "webOrigins": [
        "http://localhost:8888",
        "http://127.0.0.1:8888"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "skytrace-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "skytrace-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "skytrace-service",
      "name": "SkyTrace Service Account",
      "description": "用于脚本和后端服务通过 client_credentials 调用 SkyTrace API",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SKYTRACE_SERVICE_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "skytrace-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "skytrace-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "skytrace-admin",
      "enabled": true,
      "email": "skytrace-admin@local.test",
      "emailVerified": true,
      "firstName": "SkyTrace",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "${SKYTRACE_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "skytrace-operator",
      "enabled": true,
      "email": "skytrace-operator@local.test",
      "emailVerified": true,
      "firstName": "SkyTrace",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "${SKYTRACE_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPERATOR"
      ]
    },
    {
      "username": "skytrace-viewer",
      "enabled": true,
      "email": "skytrace-viewer@local.test",
      "emailVerified": true,
      "firstName": "SkyTrace",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "${SKYTRACE_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VIEWER"
      ]
    },
    {
      "username": "service-account-skytrace-service",
      "enabled": true,
      "serviceAccountClientId": "skytrace-service",
      "realmRoles": [
        "OPERATOR"
      ]
    }
  ]
}
